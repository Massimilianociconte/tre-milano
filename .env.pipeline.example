# TRE Milano — pipeline amministrativa locale/CI. Non importare in Netlify.
# Copiare in un secret store CI o in un `.env.pipeline` non versionato.

SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SECRET_KEY=
# Fallback legacy; lasciare vuoto con una chiave moderna `sb_secret_*`.
SUPABASE_SERVICE_ROLE_KEY=

# Scrittura bloccata finché non è `false` e il comando non include
# contemporaneamente `--confirm-write`.
DATA_IMPORT_DRY_RUN=true
DATA_IMPORT_BATCH_SIZE=250
DATA_RPC_TIMEOUT_MS=60000

# Solo CLI/migrazioni/backup. Mai frontend o Netlify Functions.
SUPABASE_ACCESS_TOKEN=
SUPABASE_PROJECT_ID=
SUPABASE_DB_URL=
