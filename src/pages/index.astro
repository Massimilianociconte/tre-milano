---
import BaseLayout from '@/layouts/BaseLayout.astro';
import BottomNav from '@/components/layout/BottomNav.astro';
import DiscoveryExperience from '@/components/discovery/DiscoveryExperience';
import CuratedCollection from '@/components/editorial/CuratedCollection.astro';
import ResponsiveImage from '@/components/media/ResponsiveImage.astro';
import '@/styles/homepage-premium.css';
---

<BaseLayout
  title="TRE Milano — Tre posti. Quello giusto, adesso."
  description="Scopri dove andare a Milano con una top 3 spiegata: tre scelte motivate per momento, distanza, budget, atmosfera e qualità dei dati."
  bodyClass="home-shell"
>
  <div class="home-page">
    <section class="home-hero" aria-labelledby="home-title">
      <div class="home-hero__inner">
        <div class="home-hero__copy">
          <div>
            <span class="home-hero__edition">Concierge editoriale · Milano</span>
            <h1 id="home-title">Il meglio di Milano.<br /><em>Selezionato per te.</em></h1>
            <p class="home-hero__lede">La tua top 3 perfetta.</p>
            <p class="home-hero__proof">Tre scelte motivate per momento, distanza, budget e atmosfera. Nessuna lista infinita.</p>
            <a class="home-hero__method" href="/metodologia/">Scopri come scegliamo <span aria-hidden="true">↗</span></a>
          </div>
        </div>
        <ResponsiveImage
          class="home-hero__media"
          src="/images/hero-milano.jpg"
          alt=""
          width={1672}
          height={941}
          sizes="(max-width: 760px) 100vw, 46vw"
          loading="eager"
          fetchpriority="high"
          decorative
        />
        <div class="home-hero__values" aria-label="Valori di TRE Milano">
          <span><i aria-hidden="true"></i>Curato</span>
          <span><i aria-hidden="true"></i>Locale</span>
          <span><i aria-hidden="true"></i>Spiegato</span>
        </div>
      </div>
    </section>

    <DiscoveryExperience client:load />

    <section class="category-section shell" aria-labelledby="categories-title">
      <div class="section-heading section-heading--inline">
        <div>
          <span class="section-kicker">Milano, secondo te</span>
          <h2 id="categories-title">Non una categoria.<br />Il momento giusto.</h2>
        </div>
        <p>Quattro modi di iniziare. La ricerca li trasforma in una selezione personale.</p>
      </div>
      <nav class="occasion-grid" aria-label="Esplora per occasione">
        <a class="occasion-card occasion-card--wide" href="/categorie/cocktail-bar/">
          <img src="/images/venue-cocktail.webp" alt="Cocktail ambrato in un ambiente milanese raccolto" width="900" height="1124" loading="lazy" />
          <span class="occasion-card__index">01</span>
          <span class="occasion-card__copy"><small>Dopo il lavoro</small><strong>Aperitivo, fatto bene.</strong><em>Esplora i cocktail bar</em></span>
        </a>
        <a class="occasion-card" href="/occasioni/cena-romantica/">
          <img src="/images/venue-ristorante.webp" alt="Tavolo elegante preparato per una cena a due" width="900" height="1124" loading="lazy" />
          <span class="occasion-card__index">02</span>
          <span class="occasion-card__copy"><small>Per due</small><strong>Una cena che resta.</strong><em>Scopri la selezione</em></span>
        </a>
        <a class="occasion-card" href="/milano/">
          <img src="/images/hero-milano.webp" alt="Panorama serale di Milano da una terrazza" width="1672" height="941" loading="lazy" />
          <span class="occasion-card__index">03</span>
          <span class="occasion-card__copy"><small>Sopra la città</small><strong>Milano dall’alto.</strong><em>Trova il rooftop</em></span>
        </a>
        <a class="occasion-card occasion-card--wide" href="/guide/milano-di-sera/">
          <img src="/images/galleria-milano.webp" alt="Galleria Vittorio Emanuele II nella luce della sera" width="1400" height="933" loading="lazy" />
          <span class="occasion-card__index">04</span>
          <span class="occasion-card__copy"><small>Dopo il tramonto</small><strong>Milano cambia ritmo.</strong><em>Leggi la guida</em></span>
        </a>
      </nav>
    </section>

    <CuratedCollection />

    <section class="editorial-split" aria-labelledby="night-title">
      <div class="editorial-split__copy">
        <div>
          <span class="section-kicker">Taccuino 01 · La sera</span>
          <h2 id="night-title">La città non si sceglie dalla classifica.</h2>
          <p>Atmosfera, facilità di conversazione e distanza reale contano più della popolarità. La guida mostra criteri, trade-off e stato delle fonti.</p>
          <a class="text-link" href="/guide/milano-di-sera/">Leggi la guida <svg viewBox="0 0 24 24"><path d="M5 12h14M14 7l5 5-5 5" /></svg></a>
        </div>
      </div>
      <div class="editorial-split__media">
        <img src="/images/galleria-milano.webp" alt="Galleria Vittorio Emanuele II in una quieta luce serale" width="1400" height="933" loading="lazy" />
      </div>
    </section>

    <section class="method-strip" aria-labelledby="method-title">
      <div class="shell">
        <div class="section-heading section-heading--inline">
          <div>
            <span class="section-kicker">Metodo, non magia</span>
            <h2 id="method-title">Tre scelte.<br />Ogni scelta, una ragione.</h2>
          </div>
          <p>Il podio nasce da vincoli, qualità del dato e diversità utile.</p>
        </div>
        <div class="method-strip__grid">
          <article class="method-step"><span class="method-step__number">01</span><h3>Rispetta i vincoli</h3><p>Orario, budget, distanza e necessità esplicite vengono prima di qualsiasi preferenza.</p></article>
          <article class="method-step"><span class="method-step__number">02</span><h3>Spiega il fit</h3><p>Ogni scelta dichiara i motivi, il trade-off e la confidenza dei dati disponibili.</p></article>
          <article class="method-step"><span class="method-step__number">03</span><h3>Diversifica con criterio</h3><p>La terza scelta sorprende su una sola dimensione, senza tradire ciò che hai chiesto.</p></article>
        </div>
      </div>
    </section>
  </div>
  <BottomNav />
</BaseLayout>
