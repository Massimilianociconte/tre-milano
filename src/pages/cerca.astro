---
import BaseLayout from '@/layouts/BaseLayout.astro';
import BottomNav from '@/components/layout/BottomNav.astro';
import DiscoveryExperience from '@/components/discovery/DiscoveryExperience';
import { SITE } from '@/config/site';
---

<BaseLayout title="Cerca la tua top 3 — TRE Milano" description="Descrivi la serata che desideri e prova la ricerca semantica locale di TRE Milano con vincoli per quartiere, budget, distanza e apertura." noindex={true}>
  <section class="editorial-hero" style="padding-bottom: 6rem">
    <div class="shell">
      <span class="editorial-eyebrow">{SITE.preview ? 'Ricerca in anteprima' : 'Ricerca semantica'}</span>
      <h1 style="max-width: 820px">Dimmi che serata vuoi.</h1>
      <p>{SITE.preview
        ? 'Racconta occasione, zona, budget e atmosfera: ottieni tre proposte motivate dal catalogo verificato, con l’eventuale fallback dimostrativo sempre dichiarato.'
        : 'Racconta occasione, zona, budget e atmosfera: ottieni tre proposte motivate, scelte solo tra schede verificate e spiegate con i dati reali.'}</p>
    </div>
  </section>
  <div style="margin-top: -4.5rem; position: relative; z-index: 3">
    <noscript>
      <div class="shell" style="padding: 1.2rem 0 2rem">
        <div class="explore__empty">
          <strong>La ricerca interattiva richiede JavaScript.</strong>
          <p>In alternativa esplora quartieri, guide e categorie: sono pagine complete anche senza script.</p>
        </div>
      </div>
    </noscript>
    <DiscoveryExperience client:load initialQuery="aperitivo elegante" />
  </div>
  <BottomNav />
</BaseLayout>
