---
import BaseLayout from '@/layouts/BaseLayout.astro';
import BottomNav from '@/components/layout/BottomNav.astro';
import ExploreCatalog from '@/components/explore/ExploreCatalog';
---

<BaseLayout
  title="Esplora tutti i locali di Milano — TRE Milano"
  description="Sfoglia il catalogo completo dei locali di Milano: schede verificate dalla redazione e schede importate dalle fonti comunali, sempre distinte e dichiarate."
  noindex={true}
>
  <section class="editorial-hero editorial-hero--compact explore-hero">
    <div class="shell explore-hero__inner">
      <div class="explore-hero__copy">
        <span class="editorial-eyebrow">Catalogo completo · Milano</span>
        <h1>Esplora la città come una collezione.</h1>
        <p>
          Una galleria urbana di indirizzi, quartieri e atmosfere. Le selezioni
          <strong>verificate</strong> dalla redazione restano distinte dalle schede
          <strong>open data da verificare</strong>; solo le prime possono entrare nel podio.
        </p>
        <div class="explore-hero__legend" aria-label="Legenda del catalogo">
          <span><i aria-hidden="true"></i>Venue passport verificato</span>
          <span><i aria-hidden="true"></i>Anagrafica comunale · 31/12/2023</span>
        </div>
      </div>
      <figure class="explore-hero__visual">
        <img
          src="/images/galleria-milano.webp"
          alt="Architettura della Galleria Vittorio Emanuele II a Milano"
          width="1400"
          height="933"
          loading="eager"
          fetchpriority="high"
        />
        <figcaption><span>01</span>Milano, archivio vivo</figcaption>
      </figure>
    </div>
  </section>
  <div class="shell" style="padding-bottom: 5rem">
    <noscript>
      <div class="explore__empty" style="margin-bottom: 1.5rem">
        <strong>Il browser del catalogo richiede JavaScript.</strong>
        <p>Puoi comunque consultare le pagine editoriali di quartieri, guide e categorie dal menu.</p>
      </div>
    </noscript>
    <ExploreCatalog client:load />
  </div>
  <BottomNav />
</BaseLayout>
