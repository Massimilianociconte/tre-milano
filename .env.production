# TEMPLATE NETLIFY — contiene solo placeholder, nessun segreto reale.
# Importare/copiare nel contesto Production e compilare i valori vuoti.

# Il cutover `production` + `gold` va fatto solo dopo migrazioni, dati Gold
# verificati, testi legali approvati e smoke test. Il template resta fail-closed.
# Compilare in Netlify. Vuoto nel repository per non contaminare i canonical.
PUBLIC_SITE_URL=
PUBLIC_SITE_MODE=preview
PUBLIC_DATA_MODE=fixture

# Obbligatorie per il catalogo server-side.
SUPABASE_URL=
SUPABASE_SECRET_KEY=
RATE_LIMIT_HASH_SECRET=

# Obbligatorie soltanto quando `/api/venue-claims` sostituirà il modulo
# Netlify Forms attualmente pubblico. Il widget e la CSP vanno attivati insieme.
PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Opzionale: se assente, la Function usa l'hostname di PUBLIC_SITE_URL.
TURNSTILE_EXPECTED_HOSTNAME=YOUR_PRODUCTION_DOMAIN.example

# Obbligatoria per la configurazione Netlify production concordata.
# Il runtime mantiene comunque un fallback deterministico se non disponibile.
DEEPSEEK_API_KEY=
# Opzionali.
CATALOG_API_CACHE_SECONDS=60
CATALOG_API_RATE_LIMIT=120
CLAIM_RETENTION_DAYS=365
CLAIM_RATE_LIMIT_PER_HOUR=5
CLAIM_NOTIFICATION_WEBHOOK_URL=
ALERT_WEBHOOK_URL=
# Chiave di verifica pubblicabile: il protocollo richiede anche `/{key}.txt`.
INDEXNOW_KEY=

# Non aggiungere qui token CLI, DB URL o credenziali della pipeline.
# Usare `.env.pipeline.example` soltanto in locale/CI con accesso ristretto.
