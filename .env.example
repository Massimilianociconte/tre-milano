# TRE Milano — copia in `.env` per sviluppo locale. Non committare `.env`.

# Pubbliche: incluse nel bundle/browser. Non inserire mai segreti qui.
PUBLIC_SITE_URL=http://localhost:4321
PUBLIC_SITE_MODE=preview
PUBLIC_DATA_MODE=fixture
PUBLIC_TURNSTILE_SITE_KEY=

# Server-only: Netlify Functions. Obbligatorie per le API catalogo/claim.
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
# Preferita (chiavi Supabase 2026). `sb_secret_*` va soltanto nell'header apikey.
SUPABASE_SECRET_KEY=
# Fallback legacy JWT; lasciare vuota quando è presente SUPABASE_SECRET_KEY.
SUPABASE_SERVICE_ROLE_KEY=
RATE_LIMIT_HASH_SECRET=
TURNSTILE_SECRET_KEY=
TURNSTILE_EXPECTED_HOSTNAME=localhost

# Server-only: interprete semantico opzionale. Senza chiave resta il fallback locale.
DEEPSEEK_API_KEY=
# Cache best-effort per istanza serverless: solo hash canonici, mai query in chiaro.
DEEPSEEK_INTERPRETER_CACHE_TTL_SECONDS=300
DEEPSEEK_INTERPRETER_CACHE_MAX_ENTRIES=200

# Server-only: tuning operativo con default sicuri.
CATALOG_API_CACHE_SECONDS=60
CATALOG_API_RATE_LIMIT=120
CLAIM_RATE_LIMIT_PER_HOUR=5
CLAIM_RETENTION_DAYS=365
CLAIM_NOTIFICATION_WEBHOOK_URL=
ALERT_WEBHOOK_URL=

# Pipeline amministrativa locale/CI. Scrittura bloccata finché non è `false`
# e il comando non include anche `--confirm-write`.
DATA_IMPORT_DRY_RUN=true
DATA_IMPORT_BATCH_SIZE=250
DATA_RPC_TIMEOUT_MS=60000

# Solo migrazioni/CI, mai frontend o Netlify Function runtime. Per un template
# separato e importabile nella pipeline vedere `.env.pipeline.example`.
SUPABASE_ACCESS_TOKEN=
SUPABASE_PROJECT_ID=
SUPABASE_DB_URL=

# Indicizzazione esplicita e opzionale.
INDEXNOW_KEY=

# Tooling locale/CI opzionale; non sono secrets Netlify runtime.
CHROME_PATH=
LHCI_OUTPUT_DIR=/tmp/tre-milano-lhci
PLAYWRIGHT_BASE_URL=
PLAYWRIGHT_ARTIFACTS_DIR=test-results
CI=false
